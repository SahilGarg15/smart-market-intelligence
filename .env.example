# Rename this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.

# ── Neon PostgreSQL ─────────────────────────────────────────────────────────
# Get this from: https://console.neon.tech → Project → Connection string
# Format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── API ──────────────────────────────────────────────────────────────────────
# Optional: override the default host/port when running uvicorn
# API_HOST=0.0.0.0
# API_PORT=8000
